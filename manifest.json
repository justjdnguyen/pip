{
  "manifest_version": 3,
  "name": "Better PiP",
  "version": "0.1.0",
  "description": "Firefox-style Picture-in-Picture for Chromium: hover toggle, scrubber, volume, captions, skip, fullscreen.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Picture-in-Picture (Alt+P)",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "src/content/util.js",
        "src/content/styles.js",
        "src/content/adapters.js",
        "src/content/player-ui.js",
        "src/content/pip-session.js",
        "src/content/app-session.js",
        "src/content/toggle.js",
        "src/content/main.js"
      ]
    }
  ],
  "commands": {
    "toggle-pip": {
      "description": "Toggle Picture-in-Picture for the current video"
    }
  }
}
